# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Database (Neon Postgres) ---
# Neon connection string. Use a pooled/serverless URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Inngest (async normalization / scheduling) ---
# From the Inngest dashboard. Not needed for local `inngest dev`.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Garmin (Connect Developer Program) ---
# Eval-environment values first; swap to production after approval.
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GARMIN_REDIRECT_URI="https://app.badoo.net/api/auth/garmin/callback"
GARMIN_WEBHOOK_SECRET=""
GARMIN_AUTH_BASE_URL="https://connect.garmin.com"
GARMIN_API_BASE_URL="https://apis.garmin.com"

# --- Strava (self-serve: https://www.strava.com/settings/api) ---
# Create an app, set the Authorization Callback Domain to this app's host.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/auth/strava/callback"
# Echoed during webhook subscription validation; any opaque string.
STRAVA_VERIFY_TOKEN="throughline"
# Set after creating a push subscription (optional; enables webhook verify).
STRAVA_SUBSCRIPTION_ID=""

# --- Anthropic (athlete "ask about your training" chat) ---
ANTHROPIC_API_KEY=""
# Model. Defaults to cheap/fast Haiku (right for grounded narration). Set this to
# the EXACT current model id from your Anthropic console (e.g. a Haiku or Sonnet
# id); bump to Sonnet if you want richer coaching nuance.
ANTHROPIC_MODEL=""

# --- Email (Resend, morning delivery) ---
RESEND_API_KEY=""
EMAIL_FROM="Throughline <coach@throughline.app>"

# --- Auth (Auth.js v5: Google OAuth + passwordless email magic links) ---
# Generate a secret: `npx auth secret` (or `openssl rand -base64 33`).
AUTH_SECRET=""
# Trust the deploy host (custom domain behind a proxy). Keep true on Vercel+domain.
AUTH_TRUST_HOST="true"
# Google OAuth (https://console.cloud.google.com → Credentials → OAuth client).
# Authorized redirect URI: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend API key for magic-link emails (separate from notifications if you like).
# From email uses EMAIL_FROM below; the domain must be verified in Resend.
AUTH_RESEND_KEY=""
# Comma-separated emails granted the COACH role on sign-in (everyone else = athlete,
# which auto-creates a self-coached athlete record + onboarding on first sign-in).
COACH_EMAILS="peter@badoo.net"

# --- App ---
APP_BASE_URL="https://app.badoo.net"
