# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Database (Neon Postgres) ---
# Neon connection string. Use a pooled/serverless URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Inngest (async normalization / scheduling) ---
# From the Inngest dashboard. Not needed for local `inngest dev`.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Garmin (Connect Developer Program) ---
# Eval-environment values first; swap to production after approval.
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GARMIN_REDIRECT_URI="https://app.badoo.net/api/auth/garmin/callback"
GARMIN_WEBHOOK_SECRET=""
GARMIN_AUTH_BASE_URL="https://connect.garmin.com"
GARMIN_API_BASE_URL="https://apis.garmin.com"

# --- Email (Resend, morning delivery) ---
RESEND_API_KEY=""
EMAIL_FROM="Throughline <coach@throughline.app>"

# --- App ---
APP_BASE_URL="https://app.badoo.net"
